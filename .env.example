# Cloud mode is optional in V1. Never commit real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave these unset for accountless local mode.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Explicit public destinations for the Web Intelligence egress gateway.
# Never use `*`; include every approved source/subresource domain.
WI_EGRESS_ALLOW_DOMAINS=example.com,www.example.com
