{
  "manifest_version": 3,
  "name": "Bookmark Intelligence Quick Save",
  "version": "0.2.0",
  "description": "Send the current page to your local Bookmark Intelligence library.",
  "permissions": ["storage", "contextMenus", "activeTab", "sidePanel"],
  "action": {
    "default_title": "Save to Bookmark Intelligence",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "quick-save": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Send the current page to Bookmark Intelligence"
    }
  },
  "options_page": "options.html",
  "side_panel": { "default_path": "popup.html" }
}
